<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Step <%= stepNumber %> of <%= totalSteps %> — Please Wait</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
    body { display: flex; flex-direction: column; height: 100vh; background: #0b0f19; color: #f9fafb; overflow: hidden; }
    .top-bar {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
      padding: 12px 20px; background: #111827; border-bottom: 1px solid #1f2937; gap: 12px; z-index: 20;
    }
    .left-info { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .step-pill {
      background: linear-gradient(135deg, #2563eb, #3b82f6);
      padding: 5px 12px; border-radius: 999px; font-size: 13px; font-weight: 700;
    }
    .timer-text { font-size: 14px; color: #e5e7eb; }
    .timer-text strong { color: #38bdf8; font-size: 16px; }
    .actions { display: flex; align-items: center; gap: 10px; }
    .btn {
      padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 600;
      text-decoration: none; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-outline { background: #1f2937; color: #93c5fd; border: 1px solid #374151; }
    .btn-next { background: #10b981; color: #fff; display: none; }
    .btn-next:disabled { opacity: 0.6; cursor: wait; }
    .progress-track { width: 100%; height: 4px; background: #1f2937; }
    .progress-fill { height: 100%; width: 0%; background: #3b82f6; transition: width 0.4s linear; }
    iframe { flex: 1; width: 100%; border: none; background: #fff; }

    /* Anti-AdBlock Fullscreen Overlay */
    #adblock-modal {
      position: fixed; inset: 0; background: rgba(11,15,25,0.96); z-index: 9999;
      display: none; align-items: center; justify-content: center; padding: 20px; text-align: center;
    }
    .modal-box {
      max-width: 440px; background: #111827; border: 1px solid #ef4444;
      border-radius: 16px; padding: 30px; box-shadow: 0 25px 50px rgba(0,0,0,0.6);
    }
    .modal-box i { font-size: 44px; color: #ef4444; margin-bottom: 14px; }
    .modal-box h3 { font-size: 20px; margin-bottom: 10px; }
    .modal-box p { color: #9ca3af; font-size: 14px; line-height: 1.5; margin-bottom: 20px; }
    .btn-reload { background: #ef4444; color: #fff; padding: 10px 18px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer; }
  </style>
</head>
<body>
  <div class="top-bar">
    <div class="left-info">
      <span class="step-pill">Article <%= stepNumber %> of <%= totalSteps %></span>
      <span class="timer-text" id="statusText">
        Reading timer: <strong id="countdown"><%= waitSeconds %></strong>s remaining
      </span>
    </div>
    <div class="actions">
      <a class="btn btn-outline" href="<%= article.url %>" target="_blank" rel="noopener">
        <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Article
      </a>
      <button class="btn btn-next" id="continueBtn">
        <%= stepNumber === totalSteps ? 'Get Final Link' : 'Next Article' %> <i class="fa-solid fa-arrow-right"></i>
      </button>
    </div>
  </div>
  <div class="progress-track"><div class="progress-fill" id="progressBar"></div></div>

  <!-- Loads your already-published article without modifying your blog -->
  <iframe id="articleFrame" src="<%= article.url %>" referrerpolicy="no-referrer-when-downgrade"></iframe>

  <!-- Anti-AdBlock Overlay -->
  <div id="adblock-modal">
    <div class="modal-box">
      <i class="fa-solid fa-shield-halved"></i>
      <h3>AdBlocker Detected</h3>
      <p>Please disable your AdBlocker or Brave Shield for this site to continue the countdown and unlock your destination link.</p>
      <button class="btn-reload" onclick="location.reload()">I Disabled AdBlock — Reload</button>
    </div>
  </div>

  <!-- Bait element for AdBlock detection -->
  <div id="ad-bait" class="adsbox ad-banner pub_300x250" style="width:1px;height:1px;position:absolute;left:-9999px;">&nbsp;</div>

  <script>
    (function () {
      const totalSec = <%= waitSeconds %>;
      const slug = "<%= slug %>";
      const stepToken = "<%= stepToken %>";

      let remaining = totalSec;
      let adblockDetected = false;
      let completed = false;

      const countdownEl = document.getElementById("countdown");
      const statusText = document.getElementById("statusText");
      const progressBar = document.getElementById("progressBar");
      const continueBtn = document.getElementById("continueBtn");
      const adblockModal = document.getElementById("adblock-modal");

      // 1. Anti-AdBlock Detection (DOM bait + network probe)
      function checkAdBlock() {
        const bait = document.getElementById("ad-bait");
        if (!bait || bait.offsetHeight === 0 || bait.offsetParent === null || getComputedStyle(bait).display === "none") {
          triggerAdBlock();
          return;
        }
        fetch("https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js", {
          method: "HEAD",
          mode: "no-cors",
          cache: "no-store"
        }).catch(() => triggerAdBlock());
      }

      function triggerAdBlock() {
        adblockDetected = true;
        adblockModal.style.display = "flex";
      }

      setTimeout(checkAdBlock, 600);

      // 2. Anti-Skip Countdown (pauses if AdBlock active or tab hidden)
      const interval = setInterval(() => {
        if (completed || adblockDetected || document.hidden) return;

        remaining -= 1;
        const pct = Math.min(100, Math.round(((totalSec - remaining) / totalSec) * 100));
        progressBar.style.width = pct + "%";

        if (remaining > 0) {
          countdownEl.textContent = String(remaining);
        } else {
          clearInterval(interval);
          completed = true;
          statusText.innerHTML = '<i class="fa-solid fa-circle-check" style="color:#10b981;"></i> Timer complete!';
          continueBtn.style.display = "inline-flex";
          verifyAndAdvance();
        }
      }, 1000);

      async function verifyAndAdvance() {
        continueBtn.disabled = true;
        try {
          const resp = await fetch(`/s/${encodeURIComponent(slug)}/verify`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ step_token: stepToken })
          });
          const data = await resp.json();
          if (data.ok && data.nextUrl) {
            window.location.href = data.nextUrl;
          } else {
            statusText.textContent = data.error || "Verification failed. Please reload.";
            continueBtn.disabled = false;
          }
        } catch {
          statusText.textContent = "Network error. Click Next to retry.";
          continueBtn.disabled = false;
        }
      }

      continueBtn.addEventListener("click", verifyAndAdvance);
    })();
  </script>
</body>
</html>
