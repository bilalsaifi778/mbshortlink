<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Panel — MBS Shortlink</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #0b0f19; color: #f9fafb; padding: 24px; max-width: 1100px; margin: auto; }
    .card { background: #111827; border: 1px solid #1f2937; border-radius: 12px; padding: 20px; margin-bottom: 20px; }
    input, button { padding: 9px 12px; border-radius: 8px; border: 1px solid #374151; background: #1f2937; color: #fff; }
    button { background: #2563eb; border: none; cursor: pointer; font-weight: 600; }
    table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: 13px; }
    th, td { padding: 10px; border-bottom: 1px solid #1f2937; text-align: left; }
    a { color: #60a5fa; }
  </style>
</head>
<body>
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <h2>Admin Control Panel</h2>
    <a href="/dashboard">← Back to User Dashboard</a>
  </div>

  <div class="card">
    <strong>Users:</strong> <%= stats.total_users %> |
    <strong>Shortlinks:</strong> <%= stats.total_links %> |
    <strong>Completed 4-Step Views:</strong> <%= stats.total_views %>
  </div>

  <div class="card">
    <h3>Rotating Article Pool (4 Random Articles Shown Per Shortlink)</h3>
    <form method="POST" action="/admin/articles/add" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:10px;">
      <input type="text" name="title" placeholder="Article Title" required />
      <input type="url" name="url" placeholder="https://mbscrypto.blogspot.com/2026/..." style="flex:1;min-width:260px;" required />
      <button type="submit">Add Article URL</button>
    </form>

    <table>
      <thead><tr><th>Title</th><th>Article URL</th><th>Action</th></tr></thead>
      <tbody>
        <% articles.forEach(a => { %>
          <tr>
            <td><%= a.title %></td>
            <td><%= a.url %></td>
            <td>
              <form method="POST" action="/admin/articles/delete/<%= a.id %>">
                <button style="background:#dc2626;" type="submit">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h3>Withdrawal Requests</h3>
    <table>
      <thead><tr><th>User</th><th>Amount</th><th>Method</th><th>Address</th><th>Status</th><th>Action</th></tr></thead>
      <tbody>
        <% withdrawals.forEach(w => { %>
          <tr>
            <td>#<%= w.uid %> (<%= w.email %>)</td>
            <td>$<%= parseFloat(w.amount).toFixed(2) %></td>
            <td><%= w.method %></td>
            <td><%= w.address %></td>
            <td><%= w.status %></td>
            <td>
              <% if (w.status === 'pending') { %>
                <form method="POST" action="/admin/withdrawals/<%= w.id %>/approve" style="display:inline;">
                  <button style="background:#10b981;" type="submit">Approve</button>
                </form>
                <form method="POST" action="/admin/withdrawals/<%= w.id %>/reject" style="display:inline;">
                  <button style="background:#ef4444;" type="submit">Reject</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h3>Support Tickets</h3>
    <% tickets.forEach(t => { %>
      <div style="padding:12px 0;border-bottom:1px solid #1f2937;">
        <strong>#<%= t.uid %> — <%= t.subject %></strong> (<%= t.status %>)
        <p style="color:#9ca3af;margin:6px 0;"><%= t.message %></p>
        <form method="POST" action="/admin/tickets/<%= t.id %>/reply" style="display:flex;gap:8px;">
          <input type="text" name="reply" value="<%= t.admin_reply || '' %>" placeholder="Write reply..." style="flex:1;" required />
          <button type="submit">Send Reply</button>
        </form>
      </div>
    <% }) %>
  </div>
</body>
</html>
